}

# REC Manager Dashboard. Auth is split by path rather than imported at host
# level, unlike the grid block above that this app otherwise copies:
# `apps/community/src/routes/+layout.ts` redirects itself on 401 and routes to
# /denied on 403, and a 302 to an HTML login page reaches an XHR as an opaque
# CORS failure — so those two branches would never run. Pages keep (auth), so
# browser navigation still gets the sign-in redirect.
http://community.celine.localhost {
  route {
    # Clear the Keycloak SSO session, not just the proxy cookie — otherwise the
    # next visit silently re-authenticates. Same trap the webapp block documents.
    handle /oauth2/sign_out {
      redir * http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/logout?client_id=oauth2_proxy&post_logout_redirect_uri=http%3A%2F%2Fsso.celine.localhost%2Foauth2%2Fsign_out 302
    }

    handle /oauth2/* {
      reverse_proxy host-gw:4180
    }

    # The BFF serves its routes under /api, so the prefix is preserved.
    handle /api/* {
      import auth_api
      reverse_proxy host-gw:8019
    }

    handle {
      import auth
      reverse_proxy host-gw:3007
    }
  }
}

http://webapp.celine.localhost {
  route {
    # Intercept sign_out before the catch-all /oauth2/* below: send the browser
    # to Keycloak's end_session endpoint first (clears the Keycloak browser
    # session), then Keycloak redirects to sso/oauth2/sign_out which clears
    # the proxy cookie.  Without this, route{} order means /oauth2/* wins over
    # the more-specific /oauth2/sign_out in the (auth) snippet → proxy cookie
    # is cleared but Keycloak SSO session survives → silent re-auth.
    handle /oauth2/sign_out {
      redir * http://keycloak.celine.localhost/realms/celine/protocol/openid-connect/logout?client_id=oauth2_proxy&post_logout_redirect_uri=http%3A%2F%2Fsso.celine.localhost%2Foauth2%2Fsign_out 302
    }

    # handle remaining oauth2 paths (sign_in, callback, auth)
    handle /oauth2/* {
      reverse_proxy host-gw:4180
    }

    # service worker must stay fetchable without auth redirects
    handle /sw.js {
      reverse_proxy host-gw:3005
    }

    import auth

    handle_path /api/assistant/* {
      reverse_proxy host-gw:8012
    }

    handle /api* {
      reverse_proxy host-gw:8014
    }

    handle {
      reverse_proxy host-gw:3005
    }
  }
}


# The provisioning service (celine-policies, port 8010).
#
# ---------------------------------------------------------------------------
# THIS IS THE ONLY ROUTE IT GETS, AND IT IS NOT UNDER api.celine.localhost.
# ---------------------------------------------------------------------------
# It is the only service holding **realm-wide** Keycloak administration —
# `manage-users` and `manage-realm` on the celine realm, which is every account
# in the realm plus the Organizations API. It holds that grant *because* nothing
# outside the deployment can reach it, and that is the whole of the security
# argument: see celine-policies `docs/decisions/ADR-0007`.
#
# It had no route at all until 2026-09-12, on the reasoning that its callers
# reach it by container name on `celine_security_net`. **They cannot.** Nothing
# joins that network from another compose project, so `http://provisioning:8010`
# resolved from no caller this platform has: `repositories/onboarding` runs in a
# project and a network of its own, and on a developer's machine it as often
# runs from source on the host with no Docker network at all. Measured on the
# demo3 deployment the same day — neither half of onboarding could resolve the
# name, so the login step could not be exercised anywhere.
#
# **A host of its own, deliberately.** `provisioning.internal.celine.localhost`
# is one name to keep out of a public DNS zone and a public ingress; a
# `handle_path /provisioning*` under `api.celine.localhost` would put it inside
# the host every browser and every partner integration already reaches, one
# line away from an internet-facing realm-admin credential. `internal` is in
# the name so that whoever carries this block into a real deployment has to
# decide what to do with it rather than inheriting it.
#
# **No forward_auth**, and that is not an omission: its callers are services
# presenting their own bearer token, which the service verifies against the
# realm's JWKS and authorises by `provisioning.*` scope. Nothing a browser does
# touches it. Scope checking is defence in depth rather than the control — the
# control is that this hostname resolves nowhere outside a dev machine.
# ---------------------------------------------------------------------------
http://provisioning.internal.celine.localhost {
  reverse_proxy host-gw:8010
}


