    reverse_proxy host-gw:8012
  }

  handle_path /nudging* {
    reverse_proxy host-gw:8016
  }

  handle_path /flexibility* {
    reverse_proxy host-gw:8017
  }

  # Onboarding, for service-to-service callers (onboarding-cli, scripted
  # approvals). No forward_auth: these arrive with their own bearer token, which
  # the service verifies against the realm's JWKS itself. The browser path is
  # onboarding.celine.localhost above.
  handle_path /onboarding* {
    reverse_proxy host-gw:8040
  }
}
